# HugrGate resident unit (NPU judge) — systemd USER unit.
# Commissioned by Volmarr's direct order, 2026-11-19 (named
# exception in the CURRENT_STATE services register, alongside
# gufo-resident and whisper-resident).
#
# Install (as the owning user, no sudo):
#   cp deploy/systemd/hugrgate-resident.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now hugrgate-resident.service
# Logs: journalctl --user -u hugrgate-resident.service
#
# The supervisor (tools/hugrgate_resident.py) hosts the HG-T1
# decision server on 127.0.0.1:8387 and owns exactly one child:
# flm serve <judge> on 127.0.0.1:52625 (XDNA2 NPU). The install
# path (%h/hugrgate-resident) and judge model are set in the unit
# at install time on the host.

[Unit]
Description=HugrGate resident decision service (NPU judge via FastFlowLM)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/hugrgate-resident
ExecStart=/usr/bin/python3 %h/hugrgate-resident/tools/hugrgate_resident.py --judge-model gemma4-it:e2b --ledger %h/hugrgate-resident/ledger.jsonl
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
# flm refuses to run under the 8 MiB memlock a user service
# inherits by default; the PAM limits file does not reach user
# services. This property is the proven fix (Phase 2 step 1).
LimitMEMLOCK=infinity
NoNewPrivileges=true

[Install]
WantedBy=default.target
