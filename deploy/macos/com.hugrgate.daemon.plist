<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- HugrGate daemon launchd agent. Gjallarbrú slice 449.
     Install (per-user):
       cp deploy/macos/com.hugrgate.daemon.plist ~/Library/LaunchAgents/
       cp deploy/macos/hugrgate.yaml ~/.config/hugrgate/hugrgate.yaml  # or your own
       launchctl load ~/Library/LaunchAgents/com.hugrgate.daemon.plist
     Logs: ~/Library/Logs/hugrgate/
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hugrgate.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/hugrgate</string>
        <string>serve</string>
        <string>--config</string>
        <string>/Users/REPLACE_ME/.config/hugrgate/hugrgate.yaml</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/REPLACE_ME/Library/Logs/hugrgate/service.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/REPLACE_ME/Library/Logs/hugrgate/service-error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/REPLACE_ME/Library/Application Support/HugrGate</string>
</dict>
</plist>
