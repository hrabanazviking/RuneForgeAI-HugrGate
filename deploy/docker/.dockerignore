# Keep the build context small and secret-free. Slice 446.

# version control
.git
.gitignore
.github

# worktrees and venvs
venv/
.venv/
wt-*/

# tests and benchmarks
tests/
benchmarks/
docs/
examples/
sdks/

# build artifacts
__pycache__/
*.pyc
*.pyo
dist/
build/
*.egg-info/
.coverage
htmlcov/

# local state and secrets
.env
*.env
*.pem
*.key
/tmp/
.hugrgate-demo/
hugrgate.yaml
